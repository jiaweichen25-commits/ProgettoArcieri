# Template per il file docker-compose.override.yml (sviluppo locale).
# Copia questo file come docker-compose.override.yml e personalizzalo.
# Il file docker-compose.override.yml è in .gitignore e NON viene committato.

services:
  db:
    ports:
      # Postgres per DBeaver/psql, solo da questo PC (senza 127.0.0.1 sarebbe visibile a tutta la rete).
      # Sul PC si usa la 5433: la 5432 e' spesso occupata da un PostgreSQL installato su Windows.
      - "127.0.0.1:5433:5432"

  backend:
    ports:
      # Swagger (/docs) solo da questo PC. Non scrivere "8000:8000" (= aperta a tutta la rete):
      # il backend si fida di X-Forwarded-For, quindi deve parlare solo con nginx.
      - "127.0.0.1:8000:8000"

  pgadmin:
    image: dpage/pgadmin4
    container_name: arcieri_pgadmin
    restart: always
    environment:
      PGADMIN_DEFAULT_EMAIL: admin@admin.com
      PGADMIN_DEFAULT_PASSWORD: admin
    ports:
      - "127.0.0.1:5050:80"   # solo da questo PC: la password admin e' debole
    depends_on:
      db:
        condition: service_healthy
    networks:
      - arcieri_network
